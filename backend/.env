# Configuration locale de Replay (valeurs alignées sur docker-compose.yml).
# Aucune donnée sensible : base de données locale de développement seulement.

# Base de données MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=replay
DB_PASSWORD=replay
DB_NAME=replay
# Mettre à true pour forcer une connexion SSL (BD distante)
DB_SSL=false

# Clé de signature des jetons JWT
SECRET_KEY=replay_cle_secrete_dev_locale_non_secrete

# Paiement en ligne (facultatif) : clé de test Stripe (sk_test_...).
# Sans clé, seuls les paiements « En main propre » fonctionnent.
STRIPE_SECRET_KEY=
# URL du frontend utilisée pour les redirections Stripe
FRONTEND_URL=http://localhost:5173
